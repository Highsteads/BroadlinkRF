<?xml version="1.0" encoding="UTF-8"?>
<Devices>
    <Device type="custom" id="rm4Pro">
        <Name>Broadlink RM4 Pro</Name>
        <ConfigUI>
            <SupportURL>https://github.com/mjg59/python-broadlink</SupportURL>
            <Field id="host" type="textfield" defaultValue="192.168.1.100">
                <Label>RM4 Pro IP address:</Label>
            </Field>
            <Field id="port" type="textfield" defaultValue="80">
                <Label>Port:</Label>
            </Field>
            <Field id="frequency" type="textfield" defaultValue="433.92">
                <Label>RF frequency (MHz):</Label>
            </Field>
            <Field id="repeat" type="menu" defaultValue="3">
                <Label>Transmit repeats:</Label>
                <List>
                    <Option value="1">1</Option>
                    <Option value="2">2</Option>
                    <Option value="3">3</Option>
                    <Option value="5">5</Option>
                </List>
            </Field>
            <Field id="codeStorePath" type="textfield" defaultValue="/Library/Application Support/Perceptive Automation/Python Scripts/broadlink_codes.json">
                <Label>RF code store:</Label>
            </Field>

            <Field id="sep_watchdog" type="separator"/>
            <Field id="watchdogHeading" type="label">
                <Label>Watchdog</Label>
            </Field>
            <Field id="watchdogNote" type="label" fontSize="small">
                <Label>An RM4 Pro says nothing when it falls off the network. It simply stops answering, and the first anyone knows is a command that does not arrive. The watchdog checks it on a timer instead, and can bring it back by cutting its power.</Label>
            </Field>
            <Field id="heartbeatMinutes" type="menu" defaultValue="5">
                <Label>Check the hub every:</Label>
                <List>
                    <Option value="0">Never (watchdog off)</Option>
                    <Option value="2">2 minutes</Option>
                    <Option value="5">5 minutes</Option>
                    <Option value="10">10 minutes</Option>
                    <Option value="30">30 minutes</Option>
                </List>
            </Field>
            <Field id="recoveryPlug" type="menu" defaultValue="0">
                <Label>Power-cycle using:</Label>
                <List class="self" method="switchable_devices" dynamicReload="true"/>
            </Field>
            <Field id="recoveryPlugNote" type="label" fontSize="small">
                <Label>The switch or smart plug the RM4 Pro is plugged into. Leave this on “None” and the watchdog will report the hub missing but will not try to fix it.</Label>
            </Field>
            <Field id="recoveryAfterMinutes" type="menu" defaultValue="10" visibleBindingId="recoveryPlug" visibleBindingValue="!0">
                <Label>Cut power after:</Label>
                <List>
                    <Option value="5">5 minutes missing</Option>
                    <Option value="10">10 minutes missing</Option>
                    <Option value="15">15 minutes missing</Option>
                    <Option value="30">30 minutes missing</Option>
                </List>
            </Field>
            <Field id="recoveryOffSeconds" type="menu" defaultValue="10" visibleBindingId="recoveryPlug" visibleBindingValue="!0">
                <Label>Hold the power off for:</Label>
                <List>
                    <Option value="5">5 seconds</Option>
                    <Option value="10">10 seconds</Option>
                    <Option value="20">20 seconds</Option>
                    <Option value="30">30 seconds</Option>
                </List>
            </Field>
            <Field id="recoveryMaxAttempts" type="menu" defaultValue="2" visibleBindingId="recoveryPlug" visibleBindingValue="!0">
                <Label>Try at most:</Label>
                <List>
                    <Option value="1">once</Option>
                    <Option value="2">twice</Option>
                    <Option value="3">three times</Option>
                </List>
            </Field>
            <Field id="recoveryGiveUpNote" type="label" fontSize="small" visibleBindingId="recoveryPlug" visibleBindingValue="!0">
                <Label>After the last attempt the watchdog stops cutting power and leaves the hub alone, so a dead unit cannot be cycled all night. It allows 15 minutes between attempts, because an RM4 Pro takes about ten minutes to rejoin a network after losing power.</Label>
            </Field>
        </ConfigUI>
        <States>
            <State id="connectionState">
                <ValueType>String</ValueType>
                <TriggerLabel>Connection State</TriggerLabel>
                <ControlPageLabel>Connection State</ControlPageLabel>
            </State>
            <State id="firmwareVersion">
                <ValueType>String</ValueType>
                <TriggerLabel>Firmware Version</TriggerLabel>
                <ControlPageLabel>Firmware Version</ControlPageLabel>
            </State>
            <State id="configuredFrequency">
                <ValueType>Number</ValueType>
                <TriggerLabel>RF Frequency</TriggerLabel>
                <ControlPageLabel>RF Frequency</ControlPageLabel>
            </State>
            <State id="codeCount">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Stored RF Code Count</TriggerLabel>
                <ControlPageLabel>Stored RF Code Count</ControlPageLabel>
            </State>
            <State id="lastCommand">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Command</TriggerLabel>
                <ControlPageLabel>Last Command</ControlPageLabel>
            </State>
            <State id="lastResult">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Result</TriggerLabel>
                <ControlPageLabel>Last Result</ControlPageLabel>
            </State>
            <State id="lastError">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Error</TriggerLabel>
                <ControlPageLabel>Last Error</ControlPageLabel>
            </State>
            <State id="lastSentAt">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Sent At</TriggerLabel>
                <ControlPageLabel>Last Sent At</ControlPageLabel>
            </State>
            <State id="sentCount">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Sent Count</TriggerLabel>
                <ControlPageLabel>Sent Count</ControlPageLabel>
            </State>
            <State id="lastCheckedAt">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Checked At</TriggerLabel>
                <ControlPageLabel>Last Checked At</ControlPageLabel>
            </State>
            <State id="unreachableSince">
                <ValueType>String</ValueType>
                <TriggerLabel>Unreachable Since</TriggerLabel>
                <ControlPageLabel>Unreachable Since</ControlPageLabel>
            </State>
            <State id="recoveryAttempts">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Recovery Attempts</TriggerLabel>
                <ControlPageLabel>Recovery Attempts</ControlPageLabel>
            </State>
            <State id="lastRecoveryAt">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Recovery At</TriggerLabel>
                <ControlPageLabel>Last Recovery At</ControlPageLabel>
            </State>
        </States>
        <UiDisplayStateId>connectionState</UiDisplayStateId>
    </Device>

    <Device type="custom" id="rfCommand">
        <Name>Broadlink RF Command</Name>
        <ConfigUI>
            <SupportURL>https://github.com/mjg59/python-broadlink</SupportURL>
            <Field id="hubDevice" type="menu">
                <Label>RM4 Pro:</Label>
                <List class="self" method="hub_devices" dynamicReload="true"/>
            </Field>
            <Field id="codeName" type="menu">
                <Label>RF command:</Label>
                <List class="self" method="available_codes" dynamicReload="true"/>
            </Field>
            <Field id="repeatOverride" type="menu" defaultValue="">
                <Label>Repeat override:</Label>
                <List>
                    <Option value="">Use RM4 default</Option>
                    <Option value="1">1</Option>
                    <Option value="2">2</Option>
                    <Option value="3">3</Option>
                    <Option value="5">5</Option>
                </List>
            </Field>
            <Field id="description" type="label">
                <Label>Use the device action “Send RF Command”, or use the plugin menu to learn a new code. The command name is selected here and never needs to be edited in Python.</Label>
            </Field>
        </ConfigUI>
        <States>
            <State id="selectedCode">
                <ValueType>String</ValueType>
                <TriggerLabel>Selected RF Code</TriggerLabel>
                <ControlPageLabel>Selected RF Code</ControlPageLabel>
            </State>
            <State id="selectedFrequency">
                <ValueType>Number</ValueType>
                <TriggerLabel>Selected RF Frequency</TriggerLabel>
                <ControlPageLabel>Selected RF Frequency</ControlPageLabel>
            </State>
            <State id="lastResult">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Result</TriggerLabel>
                <ControlPageLabel>Last Result</ControlPageLabel>
            </State>
            <State id="lastError">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Error</TriggerLabel>
                <ControlPageLabel>Last Error</ControlPageLabel>
            </State>
            <State id="lastSentAt">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Sent At</TriggerLabel>
                <ControlPageLabel>Last Sent At</ControlPageLabel>
            </State>
            <State id="sentCount">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Sent Count</TriggerLabel>
                <ControlPageLabel>Sent Count</ControlPageLabel>
            </State>
        </States>
        <UiDisplayStateId>lastResult</UiDisplayStateId>
    </Device>

    <Device type="relay" id="rfRelay">
        <Name>Broadlink RF Relay</Name>
        <ConfigUI>
            <SupportURL>https://github.com/mjg59/python-broadlink</SupportURL>
            <Field id="hubDevice" type="menu">
                <Label>RM4 Pro:</Label>
                <List class="self" method="hub_devices" dynamicReload="true"/>
            </Field>
            <Field id="onCodeName" type="menu">
                <Label>On RF command:</Label>
                <List class="self" method="available_codes" dynamicReload="true"/>
            </Field>
            <Field id="offCodeName" type="menu">
                <Label>Off RF command:</Label>
                <List class="self" method="available_codes" dynamicReload="true"/>
            </Field>
            <Field id="repeatOverride" type="menu" defaultValue="">
                <Label>Repeat override:</Label>
                <List>
                    <Option value="">Use RM4 default</Option>
                    <Option value="1">1</Option>
                    <Option value="2">2</Option>
                    <Option value="3">3</Option>
                    <Option value="5">5</Option>
                </List>
            </Field>
            <Field id="sepFeedback" type="separator"/>
            <Field id="feedbackHelp" type="label" fontSize="small">
                <Label>Optional. RF has no return path, so without a power meter this device's state is only the last code sent. Choose the smart plug or meter the appliance runs on and the state follows its reading instead, including presses on the appliance's own remote.</Label>
            </Field>
            <Field id="feedbackDevice" type="menu" defaultValue="0">
                <Label>Power meter:</Label>
                <List class="self" method="meter_devices" dynamicReload="true"/>
                <CallbackMethod>feedback_device_changed</CallbackMethod>
            </Field>
            <Field id="feedbackStateName" type="menu" defaultValue="">
                <Label>Reading:</Label>
                <List class="self" method="meter_states" dynamicReload="true"/>
            </Field>
            <Field id="feedbackOnWatts" type="textfield" defaultValue="10">
                <Label>On above (watts):</Label>
            </Field>
            <Field id="feedbackTimeoutSeconds" type="textfield" defaultValue="90">
                <Label>Confirm within (seconds):</Label>
            </Field>
            <Field id="feedbackHeavyWatts" type="textfield" defaultValue="">
                <Label>Heavy load above (watts):</Label>
            </Field>
            <Field id="feedbackHeavyHelp" type="label" fontSize="small" alignWithControl="true">
                <Label>Optional. Sets the Heavy Load state, e.g. 500 to see when a fire's heater is running.</Label>
            </Field>
        </ConfigUI>
        <States>
            <State id="lastCommand">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Command</TriggerLabel>
                <ControlPageLabel>Last Command</ControlPageLabel>
            </State>
            <State id="lastResult">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Result</TriggerLabel>
                <ControlPageLabel>Last Result</ControlPageLabel>
            </State>
            <State id="lastError">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Error</TriggerLabel>
                <ControlPageLabel>Last Error</ControlPageLabel>
            </State>
            <State id="lastSentAt">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Sent At</TriggerLabel>
                <ControlPageLabel>Last Sent At</ControlPageLabel>
            </State>
            <State id="sentCount">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Sent Count</TriggerLabel>
                <ControlPageLabel>Sent Count</ControlPageLabel>
            </State>
            <State id="measuredWatts">
                <ValueType>Number</ValueType>
                <TriggerLabel>Measured Watts</TriggerLabel>
                <ControlPageLabel>Measured Watts</ControlPageLabel>
            </State>
            <State id="measuredState">
                <ValueType>String</ValueType>
                <TriggerLabel>Measured State (on, off or unknown)</TriggerLabel>
                <ControlPageLabel>Measured State</ControlPageLabel>
            </State>
            <State id="feedbackStatus">
                <ValueType>String</ValueType>
                <TriggerLabel>Feedback Status</TriggerLabel>
                <ControlPageLabel>Feedback Status</ControlPageLabel>
            </State>
            <State id="heavyLoad">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Heavy Load</TriggerLabel>
                <ControlPageLabel>Heavy Load</ControlPageLabel>
            </State>
        </States>
        <UiDisplayStateId>onOffState</UiDisplayStateId>
    </Device>
</Devices>
